{
  "version": 2,
  "port": 3030,
  "bind_host": "127.0.0.1",
  "admin_path": "admin",
  "admin_username": "admin",
  "admin_password": "CHANGE-ME-TO-A-STRONG-PASSWORD",
  "audit_max_body_bytes": 1048576,
  "sites": [
    {
      "id": "docs",
      "name": "Documentation",
      "enabled": true,
      "debug_enabled": false,
      "external_callback": {
        "enabled": false,
        "template_id": "",
        "signing_key_env": "IH_CALLBACK_SIGNING_KEY",
        "vmq_enabled": false,
        "vmq_key_env": "IH_CALLBACK_VMQ_KEY",
        "page_enabled": false,
        "auto_run": false
      },
      "api_proxy": {
        "enabled": false,
        "path_prefixes": ["/v1"],
        "first_byte_timeout_seconds": 120,
        "idle_timeout_seconds": 120,
        "apply_request_rules": false,
        "rewrite_request_headers": false
      },
      "value_rules_enabled": true,
      "target_url": "https://docs.example.com/",
      "proxy_prefix": "/internal-content",
      "replace_rules": [
        {
          "comment": "Example: redirect a download to a controlled file",
          "pattern": "https://docs.example.com/launcher.exe",
          "replacement": "https://your-server.com/file.exe",
          "mode": "literal"
        },
        {
          "comment": "Example: strip a referral parameter via regex",
          "pattern": "[?&]ref=[^&\"']+",
          "replacement": "",
          "mode": "regex"
        }
      ],
      "oauth_bypass_paths": [
        "/auth/callback",
        "/oauth/redirect"
      ],
      "rewrite_request_headers": true,
      "audit_probe": {
        "enabled": false
      },
      "captcha": {
        "enabled": false,
        "provider": "2captcha",
        "api_key_env": "CAPTCHA_2CAPTCHA_API_KEY",
        "site_key": "",
        "page_path": "/login",
        "timeout_seconds": 120,
        "max_tasks_per_hour": 3,
        "mode": "native_first",
        "response_selector": "",
        "response_field_name": "",
        "callback_path": "",
        "waiting_message": "",
        "ready_message": "",
        "result_ttl_seconds": 120
      },
      "monitor": {
        "enabled": false,
        "path": "/purchase",
        "mode": "auto",
        "pattern": "",
        "interval_seconds": 300,
        "timeout_seconds": 15,
        "notify_on_first_run": false,
        "notify_on_error": true,
        "include_assets": true,
        "pushplus_token_env": "IH_PUSHPLUS_TOKEN",
        "title_template": "Original site changed: {site}"
      },
      "payment": {
        "enabled": false,
        "adapter": "generic",
        "capture_enabled": false,
        "capture_url_pattern": "^/api/v1/payment/orders(?:[?#]|$)",
        "capture_match_mode": "regex",
        "field_map": {
          "order_ref": "order_ref",
          "amount": "amount",
          "qr_content": "qr_content",
          "expires_at": "expires_at",
          "channel": "channel",
          "currency": "currency"
        },
        "require_user_approval": true,
        "auto_dispatch": false,
        "default_execution": "qr_display",
        "device_id": "",
        "device_token_env": "IH_DEVICE_AGENT_TOKEN"
      },
      "intercept": {
        "enabled": false,
        "url_pattern": "^/api/login",
        "match_mode": "regex",
        "status": 200,
        "content_type": "application/json; charset=utf-8",
        "timeout_ms": 1000,
        "headers": {},
        "code": "return { status: 200, body: { ok: true, path: request.path } };"
      },
      "response_rules": [
        {
          "enabled": false,
          "url_pattern": "^/api/user",
          "match_mode": "regex",
          "target": "json",
          "key": "data.token",
          "timeout_ms": 1000,
          "code": "return String(value) + '-x';"
        }
      ]
    }
  ]
}
